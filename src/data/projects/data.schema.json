{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "title": "List of Projects",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "title": "Project Name"
      },
      "description": {
        "type": "string",
        "title": "A brief description to the project"
      },
      "activity": {
        "type": "integer",
        "enum": [1, 2, 3, 4, 5],
        "title": "Project activity status",
        "description": "1 - Early development\n 2 - Active development\n 3 - Maintenance mode\n 4 - Inactive\n 5 - Archived"
      },
      "lang": {
        "type": "string",
        "title": "Programming language"
      },
      "img": {
        "type": "string",
        "title": "Showing Image"
      },
      "link": {
        "type": "string",
        "title": "Link to the homepage"
      },
      "update": {
        "type": "string",
        "format": "date",
        "title": "The recent update time"
      },
      "github": {
        "type": "string",
        "pattern": "^[^/]+/[^/]+$",
        "title": "The GitHub repository by user/repo"
      }
    },
    "required": [
      "name",
      "img",
      "activity"
    ]
  }
}
