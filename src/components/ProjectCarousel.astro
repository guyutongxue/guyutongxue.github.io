---
import { readFileSync } from "node:fs";
import { parse } from "yaml";

interface Project {
  name: string;
  description?: string;
  img: string;
  link?: string;
  github?: string;
  activity: number;
  lang?: string;
}

const raw = readFileSync("src/data/projects/data.yml", "utf-8");
const projects: Project[] = parse(raw);

// Sort: lower activity number = more active = show first
const sorted = [...projects].sort((a, b) => a.activity - b.activity);
---

<section class="w-full py-10">
  <div class="carousel-wrapper relative max-w-5xl mx-auto px-4">
    <!-- Navigation Arrows -->
    <button
      class="carousel-prev absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 flex items-center justify-center rounded-full bg-white/80 dark:bg-gray-700/80 shadow-md backdrop-blur-sm text-gray-600 dark:text-gray-300 hover:bg-white dark:hover:bg-gray-600 transition-colors cursor-pointer disabled:opacity-30 disabled:cursor-default"
      aria-label="上一个"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <button
      class="carousel-next absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 flex items-center justify-center rounded-full bg-white/80 dark:bg-gray-700/80 shadow-md backdrop-blur-sm text-gray-600 dark:text-gray-300 hover:bg-white dark:hover:bg-gray-600 transition-colors cursor-pointer disabled:opacity-30 disabled:cursor-default"
      aria-label="下一个"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <!-- Carousel Track -->
    <div class="carousel-viewport overflow-hidden rounded-2xl mx-8">
      <div
        class="carousel-track flex transition-transform duration-500 ease-in-out"
      >
        {
          sorted.map((project) => {
            const href =
              project.link ??
              (project.github
                ? `https://github.com/${project.github}`
                : undefined);
            return (
              <div class="carousel-slide w-full flex-shrink-0 px-2 group">
                <div class="flex flex-col sm:flex-row items-center gap-6 p-6 sm:p-8 rounded-2xl bg-gray-50 dark:bg-gray-800/60 border border-gray-200/60 dark:border-gray-700/60 group-[:has(a:hover)]:border-amber-400/60 dark:group-[:has(a:hover)]:border-amber-400/40 transition-all duration-300">
                  {/* Image */}
                  <div class="flex-shrink-0 w-24 h-24 sm:w-48 sm:h-48 rounded-xl overflow-hidden bg-white dark:bg-gray-700 p-2 shadow-sm">
                    <img
                      src={project.img}
                      alt={project.name}
                      class="w-full h-full object-contain"
                      loading="lazy"
                    />
                  </div>

                  {/* Content */}
                  <div class="flex-1 min-w-0 text-center sm:text-left">
                    <h3 class="text-lg sm:text-xl font-semibold text-gray-900 dark:text-gray-100 group-[:has(a:hover)]:text-amber-600 dark:group-[:has(a:hover)]:text-amber-400 transition-colors truncate">
                      {project.name}
                    </h3>
                    {project.description && (
                      <p class="mt-2 text-sm sm:text-base text-gray-600 dark:text-gray-400 line-clamp-2">
                        {project.description}
                      </p>
                    )}
                    <div class="mt-3 flex flex-wrap items-center justify-center sm:justify-start gap-3 text-sm text-gray-500 dark:text-gray-500">
                      {project.lang && (
                        <span class="badge badge-soft badge-accent">
                          {project.lang}
                        </span>
                      )}
                      {project.github && (
                        <span class="flex items-center gap-1">
                          <svg
                            class="w-3.5 h-3.5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                          </svg>
                          {project.github}
                        </span>
                      )}
                    </div>
                    <a
                      class="mt-3 btn btn-primary"
                      href={href}
                      target="_blank"
                      rel="noopener noreferrer">
                      查看详情
                    </a>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Dots -->
    <div class="carousel-dots flex justify-center gap-2 mt-6">
      {
        sorted.map((_, i) => (
          <button
            class:list={[
              "carousel-dot w-2 h-2 rounded-full transition-all duration-300 cursor-pointer",
              i === 0
                ? "bg-amber-500 w-6"
                : "bg-gray-300 dark:bg-gray-600 hover:bg-gray-400 dark:hover:bg-gray-500",
            ]}
            aria-label={`第 ${i + 1} 个项目`}
            data-index={i}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", initCarousel);
  document.addEventListener("DOMContentLoaded", initCarousel);

  function initCarousel() {
    const wrappers = document.querySelectorAll(".carousel-wrapper");
    wrappers.forEach((wrapper) => {
      const track = wrapper.querySelector(".carousel-track") as HTMLElement;
      const slides = wrapper.querySelectorAll(".carousel-slide");
      const dots = wrapper.querySelectorAll(".carousel-dot");
      const prevBtn = wrapper.querySelector(".carousel-prev") as HTMLButtonElement;
      const nextBtn = wrapper.querySelector(".carousel-next") as HTMLButtonElement;

      if (!track || slides.length === 0) return;

      let current = 0;
      let autoplayTimer: ReturnType<typeof setInterval>;
      const total = slides.length;

      function goTo(index: number) {
        current = ((index % total) + total) % total;
        track.style.transform = `translateX(-${current * 100}%)`;

        dots.forEach((dot, i) => {
          dot.classList.toggle("bg-amber-500", i === current);
          dot.classList.toggle("w-6", i === current);
          dot.classList.toggle("bg-gray-300", i !== current);
          dot.classList.toggle("dark:bg-gray-600", i !== current);
        });
      }

      function next() {
        goTo(current + 1);
      }

      function prev() {
        goTo(current - 1);
      }

      function startAutoplay() {
        stopAutoplay();
        autoplayTimer = setInterval(next, 4000);
      }

      function stopAutoplay() {
        clearInterval(autoplayTimer);
      }

      prevBtn?.addEventListener("click", () => {
        prev();
        startAutoplay();
      });

      nextBtn?.addEventListener("click", () => {
        next();
        startAutoplay();
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const index = Number((dot as HTMLElement).dataset.index);
          goTo(index);
          startAutoplay();
        });
      });

      // Pause on hover
      wrapper.addEventListener("mouseenter", stopAutoplay);
      wrapper.addEventListener("mouseleave", startAutoplay);

      // Touch / swipe support
      let touchStartX = 0;
      let touchEndX = 0;

      wrapper.addEventListener("touchstart", (e) => {
        touchStartX = (e as TouchEvent).changedTouches[0].screenX;
        stopAutoplay();
      }, { passive: true });

      wrapper.addEventListener("touchend", (e) => {
        touchEndX = (e as TouchEvent).changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 50) {
          diff > 0 ? next() : prev();
        }
        startAutoplay();
      }, { passive: true });

      // Keyboard support
      wrapper.setAttribute("tabindex", "0");
      wrapper.addEventListener("keydown", (e) => {
        const key = (e as KeyboardEvent).key;
        if (key === "ArrowLeft") {
          prev();
          startAutoplay();
        } else if (key === "ArrowRight") {
          next();
          startAutoplay();
        }
      });

      startAutoplay();
    });
  }
</script>
